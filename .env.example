# ==============================================================================
# .env.example — ARE (Arequipa RescUE)
# Copie este archivo a ".env" para uso local y complete las contraseñas.
# Nunca versione un archivo ".env" con credenciales reales.
# ==============================================================================

# Base de datos MySQL (compose.yaml y application.properties)
ARE_DB_NAME=arequipa_rescue
ARE_DB_USERNAME=are_user
ARE_DB_PASSWORD=CHANGE_ME_APP_PASSWORD
ARE_DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
ARE_DB_PORT=3306

# URL JDBC obligatoria para Spring Boot (application.properties no usa fallback silencioso)
# Para desarrollo o demo use arequipa_rescue_demo; para arequipa_rescue use el perfil 'historical'.
ARE_DB_URL=jdbc:mysql://localhost:3306/arequipa_rescue_demo?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# URL JDBC opcional del perfil 'demo' (application-demo.properties)
ARE_DB_DEMO_URL=jdbc:mysql://localhost:3306/arequipa_rescue_demo?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# URL JDBC aislada para pruebas de integración MySQL (application-mysql-test.properties)
ARE_DB_TEST_URL=jdbc:mysql://localhost:3306/arequipa_rescue_test?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Protección de base histórica: manténgala en false salvo migración autorizada y respaldada
ARE_ALLOW_HISTORICAL_MIGRATION=false

# Puerto HTTP de la aplicación Spring Boot
ARE_SERVER_PORT=8080
